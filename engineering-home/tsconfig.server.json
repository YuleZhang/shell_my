{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "types": ["node"], "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
